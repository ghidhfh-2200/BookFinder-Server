# BookFinder 配置模板。复制为 .env 后填写。
#
# 这里只放连接串与密钥——凡是「只有能登录服务器的人才该改」的东西。
# 运行参数（清理周期、分页上限、资源上限、告警开关）在管理页配置，
# 存于 data/system_config.json。

# ============ 服务器 ============
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# 可信反向代理的地址或 CIDR，逗号分隔。
#
# 只有来自这些地址的请求，其 X-Forwarded-For 才被采信。这一项决定 ClientIP()
# 是否可信，而封禁与限流都以它为判据：若采信任意来源，被封者改一个请求头即可
# 绕过封禁，更能凭伪造的来源把任意 IP 送进封禁名单。
#
#   服务在 Nginx / Caddy 之后 → 填反代地址，同机通常是 127.0.0.1
#   服务直接对外监听         → 显式留空，一律以 TCP 对端地址为准
#
# 注意反代侧也要配，两处缺一不可：
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# 只写 proxy_pass 不会自动转发真实来源。缺任一步，全部访问者会共用同一个
# 来源——限流互相牵连，封禁无法定位到人。配错时日志里会有 ERROR 提示。
#
# 不允许填 0.0.0.0/0 或 ::/0，那等于信任任何来源，启动会直接失败。
TRUSTED_PROXIES=127.0.0.1

# ============ 业务数据库（MySQL 8.0+）============
#
# 必须 8.0 及以上：图书馆搜索用 ngram 解析器的全文索引，那是 8.0 才有的。
# 表由程序自动迁移，只需先建好空库：
#   CREATE DATABASE bookfinder CHARACTER SET utf8mb4;
#
# 运行日志与操作日志也在这个库里（logs / operation_logs），走独立连接。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bookfinder

# ============ 应用数据库（本地 SQLite）============
#
# 存管理员、封禁主体与标识、申诉。这些必须跨重启存活，故不放 Redis。
# 文件与表首次启动自动创建。
APP_DB_PATH=./data/app.db

# ============ Redis ============
#
# 存限流计数与访问统计，以自然日为单位过期。
# 不要求持久化：计数丢失只影响当日配额。Redis 不可用时限流整体放行，
# 服务照常读写，兜底靠封禁名单与全局并发闸。
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============ 外部配置文件 ============
#
# 这两个文件不会自动创建，必须随部署提供（仓库里的可直接用作起点）。
# 另外 data/system_config.json 与 data/app.db 会自动创建。

# 限流与自动封禁规则。改这个文件并在管理页保存即热生效，无需重启。
RATE_RULES_PATH=./data/rate_rules.json

# 图书馆 Info 字段注册表：声明允许出现哪些字段及其类型。
# 增删字段只需改这个文件并重启，库中已有记录由后端自动补全，无需迁移。
LIBRARY_SCHEMA_PATH=./data/library_schema.json

# 系统运行参数。文件不存在时以默认值创建一份。
SYSTEM_CONFIG_PATH=./data/system_config.json

# ============ 安全 ============

# 管理员令牌与访问者令牌共用的签名密钥。留空则启动失败。
#
# 访问者令牌必须能验真，否则「没带就发一个新的」会让按令牌计数的限流形同不存在：
# 不带 Cookie 的请求每次都是全新访问者、每次都拿满配额，那正是 API 被盗刷的主路径。
#
# 变更会使已签发的令牌全部失效，访问者需重新领取，仅此而已。
JWT_SECRET=

# 管理员登录入口口令：只有访问 /bookfinder/<口令> 才会显示登录界面，
# 其余路径的响应与页面不存在完全一致。留空则入口完全关闭。
#
# 它是管理入口的唯一屏障（登录本身另有密码），建议足够长。
ADMIN_ENTRY_TOKEN=

# 安卓客户端请求签名密钥（HMAC）。
#
# 留空则不校验签名，此时一律不采信客户端上报的设备标识——未验签的设备标识
# 改一个请求头就能伪造，既能换新身份，也能拿他人的标识去污染其封禁。
#
# 侧载分发的现实限制：密钥内置在 APK 里，逆包即可取出。故这一层的作用是把
# 伪造门槛从「改一个请求头」抬到「逆包取密钥」，而非不可破解。
#
# 安卓侧把同一个值写进 local.properties 的 BF_HMAC_SECRET（不入版本库）。
APP_HMAC_SECRET=

# ============ 告警外发 ============
#
# 三类事件会推送：自动封禁、网段流量异常、申诉请求。
# 两条通道并行，都配好就都发——Telegram 在国内常需代理，邮件基本处处可达。
#
# 凭据只在此处配置，管理页看不到也改不了：它们能代管理员发消息，而系统配置
# 以明文 JSON 落盘、且读取接口会返回整份内容。管理页只能开关各类告警。

# Telegram 机器人。两项须同时填写或同时留空——只填一项启动会失败，
# 因为静默不发会让人误以为告警在跑，而告警的价值恰在于「没消息就是没事」。
#
# 令牌向 @BotFather 申请，形如 123456789:AA...
# 会话 ID：让机器人收一条消息后访问 /bot<令牌>/getUpdates 查看，群组为负数。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP 发信密码。服务器、端口、发件账号、收件地址都在管理页配置——
# 那些会变，密码不会。
#
# QQ 邮箱填「授权码」而非登录密码：邮箱设置 → 账号 → 开启 SMTP 服务后获取。
# 留空则邮件通道不可用，Telegram 不受影响。
SMTP_PASSWORD=

# ============ 站点信息 ============
WEBSITE_NAME=BookFinder
